# PTracker settings. Copy to .env and fill in; .env is git-ignored.
# Paths are relative to this folder unless absolute.

# --- web server ---
HOST=127.0.0.1
PORT=5001
# Never enable on an instance reachable through the gateway/Funnel:
# the Werkzeug debugger can execute code.
FLASK_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- storage ---
DATA_DIR=data
# Halachic preferences (language, Vestot/Chumrot, uprooting rule), edited on the
# Settings page; git-ignored (template: config.example.json). Missing = defaults.
APP_CONFIG_FILE=config.json

# --- Google Calendar (leave CALENDAR_ID empty to disable calendar sync) ---
CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_ALLOW_BROWSER_AUTH=true
CALENDAR_TIMEZONE=Asia/Jerusalem
# Earliest date (YYYY-MM-DD) that the "clear all" operations search from.
HISTORY_START=2000-01-01
